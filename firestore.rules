rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /bugReports/{reportId} {

      // CREATE: anonymous submissions allowed, but validated.
      // Matches app.js exactly: title defaults to "Anonymous" if left blank (it's optional
      // per its own UI placeholder), description is the required field.
      allow create: if
        request.resource.data.size() < 8000

        // Required keys must be present
        && request.resource.data.keys().hasAll(['title', 'description', 'timestamp', 'clientId'])

        // title: reporter's name, or "Anonymous" - always a non-empty string, but not
        // required to be long since "Anonymous" (9 chars) is a valid, expected value
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() < 200

        // description: the actual bug report - this is the field that matters, matches
        // the client-side 10-character minimum in app.js so a rejected write is never a
        // surprise to a user who already passed client-side validation
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() < 4000

        // clientId: used for "edit your own report" and rate-limit UI, must be a string
        && request.resource.data.clientId is string
        && request.resource.data.clientId.size() > 0

        // timestamp: must be the server's clock, not a client-supplied value (prevents
        // spoofing old/future timestamps to dodge the rate limit or edit window)
        && request.time == request.resource.data.timestamp;

      // READ: reports are visible to everyone (this is a public bug tracker, not a
      // private inbox - matches the onSnapshot listener in app.js that renders the list)
      allow read: if true;

      // UPDATE: a report can only be edited by the same client that created it
      // (matched via clientId, since there's no auth), and only within 1 hour of
      // creation. After that window, edits are locked to prevent stale/abusive changes.
      allow update: if
        request.resource.data.clientId == resource.data.clientId
        && request.time < resource.data.timestamp + duration.value(1, 'h')
        // Re-validate the same field constraints on update so an edit can't smuggle
        // in an oversized or malformed payload
        && request.resource.data.size() < 8000
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() < 4000
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() < 200
        // timestamp and clientId must not be altered by an edit
        && request.resource.data.timestamp == resource.data.timestamp
        && request.resource.data.clientId == resource.data.clientId;

      // DELETE: never allowed. Without auth there's no reliable way to confirm a
      // delete request actually comes from the original reporter, so reports are
      // permanent once created (matches "no deletes" from our design discussion).
      allow delete: if false;
    }

    // Everything else stays locked by default - explicit deny, not just "unspecified"
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
